{
	"name": "Havoc",
	"globIgnorePaths": [
		"**/package.json",
		"**/tsconfig.json",
		"**/*.spec.*",
		"**/*.d.*",
		"**/node_modules/**",
		"**/dist/**",
		"**/out/**"
	],
	"tree": {
		"$className": "Folder",
		"$path": "out",
		"include": {
			"$path": "include",
			"node_modules": {
				"$path": "node_modules/@rbxts"
			}
		},
		"public": {
			"$className": "Folder",
			"$path": "public"
		},
		"src": {
			"$className": "Folder",
			"$path": "src"
		}
	}
}
