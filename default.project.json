{
    "name": "Havoc",
    "globIgnorePaths": [
        "**/package.json",
        "**/tsconfig.json",
        "**/src/**",
        "**/*.spec.lua",
        "**/*.d.lua"
    ],
    "tree": {
        "$className": "DataModel",
        "ReplicatedStorage": {
            "$className": "Folder",
            "Havoc": {
                "$className": "Folder",
                "$path": "out/"
            }
        }
    }
}
