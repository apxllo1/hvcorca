{
    "name": "Havoc",
    "globIgnorePaths": [
        "**/package.json",
        "**/tsconfig.json"
    ],
    "tree": {
        "$className": "Folder",
        "src": {
            "$path": "out"
        },
        "include": {
            "$path": "include"
        },
        "node_modules": {
            "$path": "node_modules/@rbxts"
        }
    }
}