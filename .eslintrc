{
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "jsx": true,
    "useJSXTextNode": true,
    "ecmaVersion": "latest",
    "sourceType": "module",
    "project": "./tsconfig.json"
  },
  "ignorePatterns": [
    "/out",
    "/public"
  ],
  "plugins": [
    "@typescript-eslint",
    "roblox-ts",
    "prettier"
  ],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:@typescript-eslint/recommended-requiring-type-checking",
    "plugin:roblox-ts/recommended",
    "plugin:prettier/recommended"
  ],
  "rules": {
    /* Formatting - error so CI fails on bad formatting */
    "prettier/prettier": "error",
    /* TypeScript */
    "@typescript-eslint/no-explicit-any": "error",
    "@typescript-eslint/no-unsafe-assignment": "warn",
    "@typescript-eslint/no-unsafe-call": "warn",
    "@typescript-eslint/no-unsafe-member-access": "warn",
    "@typescript-eslint/no-unsafe-return": "warn",
    "@typescript-eslint/consistent-type-imports": ["error", { "prefer": "type-imports" }],
    "@typescript-eslint/no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
    /* roblox-ts - off because hvcorca uses namespace merging intentionally */
    "roblox-ts/no-namespace-merging": "off",
    /* roblox-ts - useful extra rules */
    "roblox-ts/lua-truthiness": "error",
    "roblox-ts/no-null": "error",
    "roblox-ts/prefer-task-library": "error"
  }
}
