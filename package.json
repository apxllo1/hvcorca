{
    "name": "havoc",
    "version": "2.0.0",
    "scripts": {
        "compile": "rbxtsc --verbose",
        "watch": "rbxtsc -w",
        "build": "rojo build default.project.json --output \"Havoc.rbxm\"",
        "serve": "rojo serve place.project.json",
        "lint": "eslint src --ext .ts,.tsx",
        "fix": "eslint src --ext .ts,.tsx --fix",
        "bundle": "npm run compile && npm run build && echo 🔥 Release v$(date +%Y%m%d-%H%M) && remodel run ci/bundle.lua public/latest.lua v2.0",
        "bundle:dbg": "npm run compile && npm run build && remodel run ci/bundle.lua public/latest.debug.lua v2.0 debug",
        "bundle:min": "npm run compile && npm run build && remodel run ci/bundle.lua public/latest.lua v2.0 minify"
    },
    "devDependencies": {
        "@rbxts/compiler-types": "^1.3.2-types.0",
        "@rbxts/exploit-types": "github:richie0866/exploit-types",
        "@rbxts/types": "^1.0.571",
        "@typescript-eslint/eslint-plugin": "^5.62.0",
        "@typescript-eslint/parser": "^5.62.0",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-roblox-ts": "^0.0.32",
        "luamin": "^1.0.4",
        "prettier": "^3.8.3",
        "roblox-ts": "^1.2.7",
        "rojo": "^1.0.2",
        "typescript": "^4.5.5"
    },
    "dependencies": {
        "@rbxts/flipper": "^2.0.1",
        "@rbxts/make": "^1.0.6",
        "@rbxts/roact": "1.4.0-ts.2",
        "@rbxts/roact-hooked": "^2.0.0",
        "@rbxts/roact-rodux-hooked": "1.1.3",
        "@rbxts/rodux": "3.0.0-ts.3",
        "@rbxts/services": "^1.2.0"
    }
}
